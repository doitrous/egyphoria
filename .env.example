# =============================================================================
# egyphoria — environment TEMPLATE
#
# THIS FILE IS COMMITTED TO GIT. Never put a real secret in it.
# Copy it to .env.local (gitignored) for local dev; on Coolify set these in the
# app's Configuration > Environment Variables, not in a file.
# =============================================================================

# ---- seo-runtime (packages/CONTRACT.md: exactly these three, nothing else) --

# The seo-hub's base URL. Leave unset to run with no hub — the runtime tolerates
# that: pages still render, robots.txt/sitemap.xml fall back to their no-snapshot
# defaults, and the periodic pull simply fails silently and retries in 6h.
SEO_HUB_URL=

# Bearer secret for this site, issued by the hub. Required for the hub to push a
# snapshot, for /seo-admin, and for every /api/seo/* route.
SEO_HUB_SECRET=

# This site's slug in the hub. Only required before the first successful sync —
# once a snapshot lands, the runtime falls back to the stored siteSlug.
SEO_SITE_SLUG=egyphoria

# ---- Site origin -------------------------------------------------------------
# Public origin, no trailing slash. Used for the local hreflang fallback
# (site.config.ts) and by scripts/smoke.sh's default target.
SITE_URL=http://localhost:3000

# ---- Optional ----------------------------------------------------------------

# Set to 1 to include the web-vitals beacon (<SeoWebVitals />) in the [lang] layout.
NEXT_PUBLIC_WEB_VITALS=

# Where the JSON file store persists the pulled snapshot. Defaults to ./.data/seo-runtime.json.
# Point this at a mounted volume in production (see Dockerfile) so a restart doesn't force a
# re-pull from the hub.
SEO_STORE_PATH=./.data/seo-runtime.json

# ---- PayTabs (trip checkout — app/api/paytabs/{create,callback}/route.ts) ---
# Ported from the old static build's api/paytabs-*.js; same env names, same contract. The
# PAYTABS_SERVER_KEY is a SECRET and must never reach the browser.
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_REGION=EGY            # EGY ARE SAU OMN JOR GLOBAL
PAYTABS_CURRENCY=USD          # optional; defaults to USD
